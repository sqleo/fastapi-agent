# ==========================================
# 第一阶段：编译与依赖下载阶段 (Builder)
# ==========================================
FROM python:3.13-slim AS builder

# 1. 安装编译所需的系统依赖
# 只有这个阶段需要 build-essential 和 zlib1g-dev
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# 2. 安装 uv (从官方镜像直接拷贝二进制文件，速度最快)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# 3. 复制依赖描述文件
COPY pyproject.toml uv.lock ./

# 4. 同步环境（所有的编译、下载在这里一气呵成）
ENV UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    UV_EXTRA_INDEX_URL=https://pypi.org/simple \
    UV_HTTP_TIMEOUT=300 
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev


# ==========================================
# 第二阶段：运行阶段 (Final Runtime)
# ==========================================
FROM python:3.13-slim

WORKDIR /app

# 5. 【核心优化】从 builder 阶段直接把编译好的虚拟环境拷贝过来
# 这样你就跳过了在运行环境安装 gcc 和重新下载 torch/FlagEmbedding 的步骤
COPY --from=builder /app/.venv /app/.venv

# 6. 设置环境变量
# configs/ 在仓库根下，需 /app；业务包在 src/，需 /app/src
ENV PYTHONPATH=/app/src:/app
ENV PATH="/app/.venv/bin:$PATH"
# 告诉 uv 已经有虚拟环境了，不需要再重新创建
ENV UV_PROJECT_ENVIRONMENT=/app/.venv
# 镜像内已 COPY 本地 BGE 时禁止走 Hub，避免 huggingface_hub 全局 httpx 在 fork/重试后与业务并发冲突
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

# 7. 复制配置、本地嵌入模型与源码
#    model/ 需与 src/llamarag/local_model/embed_model.py 中一致：model/bge-small-zh-v1.5/
#    构建前请在项目根准备好该目录；大文件放前面有利于缓存（改代码时不重复 COPY 模型层）
COPY langgraph.json ./
COPY configs/ ./configs/
COPY model/ ./model/
COPY src/ ./src/

# 8. 建立静态资源目录
RUN mkdir -p static

# 9. 暴露端口 (根据你的 CMD 调整)
EXPOSE 8888

# 10. 启动服务
# 注意：如果你使用的是虚拟环境，直接运行 python 会自动指向 .venv 里的解释器
CMD ["python", "-m", "services.server"]