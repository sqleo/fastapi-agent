# ========== LangSmith ==========
LANGSMITH_PROJECT=new-agent
LANGSMITH_API_KEY=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

# ========== LangGraph Platform ==========
LANGGRAPH_API_URL=http://langgraph:8000

# ========== PostgreSQL (LangGraph Checkpointer) ==========
# 本地开发用 localhost，Docker 环境由 docker-compose 覆盖为容器名
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/langgraph
POSTGRES_PASSWORD=postgres
POSTGRES_DB=langgraph

# ========== MySQL (业务数据库) ==========
# 使用 docker-compose 内置 MySQL 时，MYSQL_HOST 设为 mysql
# 使用第三方 MySQL 时，改为对应的地址
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=app_db

# ========== Milvus (向量数据库) ==========
# 使用 docker-compose 内置 Milvus 时，MILVUS_HOST 设为 milvus
# 使用第三方 Milvus（如 Zilliz Cloud）时，改为对应的地址
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=MILVUS_COLLECTION
MILVUS_DIM=1024


# ========== JWT（登录）==========
# 必填；生产请使用 openssl rand -hex 32 等生成强随机串
