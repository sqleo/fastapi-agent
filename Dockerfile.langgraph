# ==========================================
# 第一阶段：编译阶段 (Builder)
# ==========================================
FROM python:3.13-slim AS builder

# 安装编译所需的系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# 安装 uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# 预先复制依赖文件
COPY pyproject.toml uv.lock ./

ENV UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    UV_EXTRA_INDEX_URL=https://pypi.org/simple \
    UV_HTTP_TIMEOUT=300 
# 在这里完成所有的编译和下载（包括那个麻烦的 FlagEmbedding）
# 如果下载太慢，可以加上 --index-url https://pypi.tuna.tsinghua.edu.cn/simple
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev

# ==========================================
# 第二阶段：运行阶段 (Runtime)
# ==========================================
FROM python:3.13-slim

WORKDIR /app

# 1. 【关键】直接从 builder 拷贝已经编译好的虚拟环境
# 这样第二阶段就不需要 gcc，也不需要重新下载巨大的 torch 和 FlagEmbedding
COPY --from=builder /app/.venv /app/.venv

# 2. 安装 uv (用于后续可能的管理，但不参与核心编译)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# 3. 设置环境变量
# configs/ 在仓库根下，需 /app；业务包在 src/，需 /app/src
ENV PYTHONPATH=/app/src:/app
ENV PATH="/app/.venv/bin:$PATH"
# 确保 uv 使用拷贝过来的环境，不再尝试重新创建
ENV UV_PROJECT_ENVIRONMENT=/app/.venv

# 4. 复制项目文件
COPY langgraph.json ./
COPY configs/ ./configs/
COPY src/ ./src/

# 5. 可选：如果你的项目有特殊的 install 脚本，在这里运行（通常不需要了）
# RUN uv sync --frozen --no-dev

RUN mkdir -p static

# 与你的配置保持一致
EXPOSE 8000

# 启动命令
CMD ["langgraph", "dev", "--host", "0.0.0.0", "--port", "8000"]