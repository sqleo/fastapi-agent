# ========== LangSmith ==========
LANGSMITH_PROJECT=new-agent
# LANGSMITH_API_KEY=

# ========== LLM Provider ==========
# 密钥读入 env_config.llm_deepseek_api_key；任选其一（勿加引号）
# LLM_API_KEY=...
# LLM_DEEPSEEK_API_KEY=...
# DEEPSEEK_API_KEY=...
# model / base_url 在 configs/ai_config.py；代码里 create_llm("deepseek")

# ========== LangGraph Platform ==========
# 使用第三方 LangGraph 托管时，改为对应地址
LANGGRAPH_API_URL=http://langgraph:8000

# ========== PostgreSQL (LangGraph Checkpointer) ==========
# 本地开发用 localhost，Docker 内置用 postgres，第三方改为对应地址
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/langgraph
POSTGRES_PASSWORD=postgres
POSTGRES_DB=langgraph

# ========== Redis (LangGraph Platform) ==========
# Docker 内置用 redis://redis:6379，第三方改为对应地址
REDIS_URI=redis://redis:6379

# ========== JWT（登录）==========
# 必填；生产请使用 openssl rand -hex 32 等生成强随机串
JWT_SECRET_KEY=change-me-to-a-long-random-secret
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# JWT_ISSUER=
# JWT_AUDIENCE=
# JWT_LEEWAY_SECONDS=0

# ========== MySQL (业务数据库) ==========
# Docker Compose 内服务名用 mysql；本机直连 MySQL 时用 127.0.0.1 或 host.docker.internal
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=app_db

# ========== 资料库文件本地上传 ==========
# KB_UPLOAD_REL_DIR=static/kb_uploads
# KB_UPLOAD_MAX_BYTES=104857600

# ========== Milvus (向量数据库) ==========
# Docker 内置用 milvus，第三方（如 Zilliz Cloud）改为对应地址
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=MILVUS_COLLECTION
MILVUS_DIM=1024
