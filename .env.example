# ========== LangSmith ==========
LANGSMITH_PROJECT=new-agent
# LANGSMITH_API_KEY=

# ========== LLM Provider ==========
# 密钥读入 env_config.llm_deepseek_api_key；任选其一（勿加引号）
# LLM_API_KEY=...
# LLM_DEEPSEEK_API_KEY=...
# DEEPSEEK_API_KEY=...
# 聊天 LLM：见数据库「LLM 全局设置」/llm/settings/global（厂商 base_url/api_key + chat_model）

# ========== LangGraph Platform ==========
# 使用第三方 LangGraph 托管时，改为对应地址
LANGGRAPH_API_URL=http://langgraph:8000
# langgraph dev / Studio 未合并 Assistant 配置时，本地调试用默认 user_id（须与库里 LLM 全局设置一致）
# LANGGRAPH_DEV_USER_ID=2
# /agent/chat/stream 订阅的 LangGraph stream_mode（逗号分隔），默认含 messages-tuple,values,updates,debug；可加 events、custom 等
# LANGGRAPH_AGENT_STREAM_MODES=messages-tuple,values,updates,debug,events
# 按 assistant_id 覆盖采样温度（见 src/utils/agent_temperature.py；优先于厂商 extra_config.temperature）
# LANGGRAPH_TEMPERATURE_AGENT=0.0

# ========== LangMem 长期记忆（LangGraph BaseStore + 工具）=========

# ========== LangMem 长期记忆（LangGraph BaseStore + 工具）==========
# 依赖：langgraph-checkpoint-postgres + psycopg[binary,pool]（已在 pyproject 中）。
# LANGMEM_ENABLED=1
# Store：postgres | memory | auto（默认 auto：有 POSTGRES_URI 或 LANGMEM_POSTGRES_URI 则用 PostgresStore，否则 InMemoryStore）
# LANGMEM_STORE=auto
# 可与 Checkpointer 共用库；也可单独指定：
# LANGMEM_POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/langgraph
# 连接池上限（PostgresStore）
# LANGMEM_PG_POOL_MAX=10
# 语义检索需要 PostgreSQL 安装 pgvector；无 pgvector 时会自动退化为「无向量索引」的 PostgresStore（仍可持久化，search_memory 语义能力受限）。
# 可强制关闭向量索引：LANGMEM_USE_PGVECTOR=0
# setup() 会在首次启动时建表/迁移。
# 进模型前保留最近几轮对话（1 user + 1 assistant = 1 轮）
# MEMORY_SHORT_TERM_TURNS=10

# ========== PostgreSQL (LangGraph Checkpointer) ==========
# 本地开发用 localhost，Docker 内置用 postgres，第三方改为对应地址
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/langgraph

# ========== BGE 嵌入模型（Docker：宿主机目录挂到容器 /app/model）==========
# 先在本机执行 scripts/download_model.py，得到 project/model/BAAI/bge-small-zh-v1.5/
# dev compose 固定绑定 ./model → /app/model；prod 可通过宿主机路径变量覆盖：
# BGE_MODEL_HOST_PATH=/data/models
# 或直接指定容器内模型目录（不依赖挂载布局）：
# BGE_LOCAL_MODEL_PATH=/app/model/BAAI/bge-small-zh-v1.5
# UIE_LOCAL_MODEL_PATH=/app/model/Casually/uie-nano
# UIE_ENTITY_CONFIDENCE_THRESHOLD=0.65
# UIE_ENTITY_MAX_LENGTH=512

# ========== LlamaIndex（docstore / index_store；勿与 LangGraph/LangMem 混库）==========
# 仅用于 LlamaIndex 的 Postgres 文档库与索引元数据；**不要**填 LangGraph 用的 POSTGRES_URI（除非另建 schema/表并清楚后果）。
# 推荐：同一 Postgres 实例上 **单独 database**，例如：
# LLAMAINDEX_POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/llamaindex
# 未设置时入库仅写 Milvus，不连 Postgres。
POSTGRES_PASSWORD=postgres
POSTGRES_DB=langgraph

# ========== Redis（可选，LangGraph Platform 需要时启用 profile redis）==========
# REDIS_URI=redis://redis:6379

# ========== JWT（登录）==========
# 必填；生产请使用 openssl rand -hex 32 等生成强随机串
JWT_SECRET_KEY=change-me-to-a-long-random-secret
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# JWT_ISSUER=
# JWT_AUDIENCE=
# JWT_LEEWAY_SECONDS=0

# ========== MySQL (业务数据库) ==========
# Docker Compose 内服务名用 mysql；本机直连 MySQL 时用 127.0.0.1 或 host.docker.internal
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=app_db

# ========== Milvus (向量数据库) ==========
# 推荐：完整 URI（与 docker-compose.dev.yml / prod 注入的 MILVUS_URI 一致）
# 本机跑 FastAPI、Milvus 用 compose 时容器内需写服务名，不要用 localhost
# MILVUS_URI=http://milvus:19530
# 仅本机进程直连本机 Milvus 时用：
# MILVUS_URI=http://localhost:19530
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=MILVUS_COLLECTION
MILVUS_DIM=1024
# 可选：Zilliz Cloud / 开启鉴权时
# MILVUS_TOKEN=
# MILVUS_USER=
# MILVUS_PASSWORD=
# MILVUS_DB_NAME=default

# ========== 应用日志（写入本地文件）==========
# 相对项目根目录；默认 logs/app.log
# LOG_FILE=logs/app.log
# LOG_LEVEL=INFO
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5
